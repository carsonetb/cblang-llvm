{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "CBLang",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#comments" },
		{ "include": "#modifiers" },
		{ "include": "#builtins" },
		{ "include": "#function-calls" },
		{ "include": "#function-definitions" },
		{ "include": "#class-declarations"}
	],
	"repository": {
		"class-declarations": {
			"begin": "\\b(class)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
			"beginCaptures": {
				"1": { "name": "storage.type.class.cblang" },
				"2": { "name": "entity.name.type.class.cblang" }
			},
			"end": "(?==)",
			"patterns": [
				{
					"match": "(:|\\,)\\s*([a-zA-Z_][a-zA-Z0-9_]*",
					"captures": {
						"1": { "name": "keyword.operator.cblang" },
						"2": { "name": "entity.other.inherited-class.cblang" }
					}
				}
			]
		},
		"function-definitions": {
			"begin": "\\b(scope)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
			"beginCaptures": {
				"1": { "name": "storage.type.function.cblang" },
				"2": { "name": "entity.name.function.cblang" }
			},
			"end": "\\)"
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.cblang",
				"match": "\\b(if|elif|else|while|for|return|scope|class)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.cblang",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.cblang",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.cblang",
			"match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
		},
		"comments": {
			"name": "comment.line.double-slash.cblang",
			"match": "//.*$"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.cblang",
					"match": "\\b(or|and)\\b"
				},
				{
					"name": "keyword.operator.symbolic.cblang",
					"match": "(==|<=|>=|<|>|\\+|-|\\*|\\/|\\^|%|\\|\\||&&)"
				}
			]
		},
		"arrow-operator": {
			"name": "keyword.operator.arrow.cblang",
			"match": "->"
		},
		"modifiers": {
			"name": "storage.modifier.cblang",
			"match": "\\b(cast|operator|static|const|private)\\b"
		},
		"builtins": {
			"name": "support.class.cblang",
			"match": "\\b(bool|int|char|string|array)\\b"
		},
		"functions-calls": {
			"name": "entity.name.function.cblang",
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
		}
	},
	"scopeName": "source.cblang"
}